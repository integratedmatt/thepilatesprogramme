# Site
PUBLIC_SITE_URL=https://www.thepilatesprogramme.co.uk

# Sanity (leave blank to build from the local seed content in src/content/seed)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-10-01
SANITY_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Analytics (GTM container; consent mode v2 defaults to denied)
PUBLIC_GTM_ID=

# Fonts: Adobe Fonts kit for Acumin Pro [CLIENT TO CONFIRM kit ID + licence for the new domain]
PUBLIC_TYPEKIT_ID=

# Google reviews via the official Places API (New). Find the place ID with:
#   GOOGLE_PLACES_API_KEY=... node scripts/fetch-google-reviews.mjs --find "The Pilates Programme Altrincham"
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM=The Pilates Programme <hello@thepilatesprogramme.co.uk>
NOTIFY_EMAIL=info@thepilatesprogramme.co.uk

# Lead list provider [CLIENT TO CONFIRM: Arketa vs dedicated ESP such as Kit]
LEAD_PROVIDER=log
KIT_API_KEY=
KIT_FORM_ID=

# Cron protection for /api/cron/expire-jobs
CRON_SECRET=
