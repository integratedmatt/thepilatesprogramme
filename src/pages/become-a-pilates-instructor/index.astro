---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import FactsBlock from '@/components/FactsBlock.astro';
import Timeline from '@/components/Timeline.astro';
import CourseCard from '@/components/CourseCard.astro';
import CompareTabs from '@/components/CompareTabs.astro';
import WhyUs from '@/components/WhyUs.astro';
import DatesList from '@/components/DatesList.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import EmailCapture from '@/components/EmailCapture.astro';
import Testimonials from '@/components/Testimonials.astro';
import AccreditationStrip from '@/components/AccreditationStrip.astro';
import { getSiteSettings, getQualifyCourses, getUpcomingDates, getPricingRules, getFaqsByIds, getTestimonials, getGraduates } from '@/lib/content';
import { gbp } from '@/lib/format';

const [settings, courses, allDates, rules, faqs, testimonials, graduates] = await Promise.all([
  getSiteSettings(), getQualifyCourses(), getUpcomingDates(), getPricingRules(),
  getFaqsByIds(['faq-cost', 'faq-how-long', 'faq-hours', 'faq-mat-reformer-first', 'faq-mat-experience', 'faq-reformer-access', 'faq-accreditation', 'faq-finance']),
  getTestimonials(), getGraduates(),
]);
const ids = new Set(courses.map((c) => c._id));
const dates = allDates.filter((d) => ids.has(d.course)).slice(0, 6);
const nextFor = (id: string) => allDates.find((d) => d.course === id);
const dbl = rules.find((r) => r.slug === 'double-booking');
const minPrice = Math.min(...courses.map((c) => c.price ?? Infinity));
const answer = `To become a Pilates instructor you complete a teacher training course, your practice hours and the exams. At The Pilates Programme that is four or five in-person days, usually at our Altrincham training centre, then 30 observation, 25 personal study and 25 practice teaching hours in your own time, and the exams, from ${gbp(minPrice)} all in with four interest-free payments. Most students certify in around six months.`;
const steps = [
  { title: 'Choose your course', text: 'Mat, Reformer or Barre. Take the quiz if you are unsure, or book two together and save £1,000.', meta: 'Step 1' },
  { title: 'The HUMAN MOVEMENT course', text: 'Our online anatomy and movement science course is sent to you as soon as you sign up, to work through before your in-person days.', meta: 'Step 2' },
  { title: '4 or 5 in-person days', text: "A small cohort and expert coaching, usually at our purpose-built Altrincham training centre, the first of its kind in the UK.", meta: 'Step 3' },
  { title: 'Your practice hours', text: '30 observation, 25 personal study and 25 practice teaching hours, in your own time around work and family. Most students certify in around six months.', meta: 'Step 4' },
  { title: 'The exams and your first class', text: 'All online and all included. Then cover, apply through the jobs board or launch your own classes.', meta: 'Step 5' },
];
const facts = [
  { label: 'Courses', value: 'Mat, Reformer, Barre' },
  { label: 'In-person days', value: '4 for Mat, 5 for Reformer and Barre' },
  { label: 'After the course', value: '30 observation, 25 personal study and 25 practice teaching hours' },
  { label: 'Time to certify', value: 'Usually around 6 months, anywhere from 3 to 12' },
  { label: 'Exams', value: 'Included, all online' },
  { label: 'Price', value: `${gbp(minPrice)} or 4 × ${gbp(minPrice / 4)}` },
  { label: 'Location', value: 'Mostly our purpose-built Altrincham centre; some dates elsewhere in the UK and abroad' },
  { label: 'Prerequisite', value: 'No prior certification needed' },
];
---
<Base title="Become a Pilates Instructor in Manchester | The Pilates Programme" description="How to become a certified Pilates or Barre teacher: 4 or 5 in-person days, practice hours in your own time and exams included, from £2,200. Small cohorts.">
  <Hero eyebrow="Teacher training" title="How to become a Pilates instructor" lead="One route, no shortcuts: four or five in-person days in a small cohort, your practice hours in your own time, and exams that studios trust. Everything included in one price.">
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'Become a Pilates instructor', url: '/become-a-pilates-instructor' }]} />
    <div class="hero-actions">
      <a href="#courses" class="btn btn-primary">Choose a course</a>
      <a href="/become-a-pilates-instructor/which-course" class="btn btn-secondary">Take the 60-second quiz</a>
    </div>
  </Hero>

  <Section>
    <div class="grid">
      <div class="col-7"><AnswerBox question="How do you become a Pilates instructor?" answer={answer} /></div>
      <div class="col-5"><FactsBlock facts={facts} /></div>
    </div>
  </Section>

  <Section tone="subtle">
    <header class="section-heading"><p class="eyebrow">Your route</p><h2>Your route in 5 steps</h2></header>
    <Timeline steps={steps} />
  </Section>

  <Section id="courses">
    <header class="section-heading"><p class="eyebrow">Teacher training</p><h2>Choose your first course</h2></header>
    <ul class="card-grid" role="list" data-stagger>{courses.map((c) => <li><CourseCard course={c} nextDate={nextFor(c._id)} showBestFor /></li>)}</ul>
  </Section>

  <Section tone="subtle" id="compare">
    <header class="section-heading"><p class="eyebrow">Compare</p><h2>Mat, Reformer or Barre?</h2><p class="lead">Train in the apparatus you are most passionate about. All three set you up to teach in studios, gyms, online and one to one. The difference is what you can practise on.</p></header>
    <CompareTabs courses={courses} nextFor={nextFor} id="compare-courses" />
    <p class="small muted mt-4">Job demand varies by area. The jobs board shows which disciplines local studios are hiring for right now.</p>
  </Section>

  <Section><WhyUs settings={settings} /></Section>

  {dbl && (
    <Section tone="inverse">
      <div class="grid">
        <div class="col-7"><p class="eyebrow">Double booking</p><h2>Two courses, {gbp(dbl.amount)}. Save {gbp(dbl.saving)}.</h2></div>
        <div class="col-5"><p class="lead">{dbl.summary} {dbl.detail}</p><p class="mt-4"><a href="/pricing" class="arrow-link">See how it works</a></p></div>
      </div>
    </Section>
  )}

  <Section>
    <div class="grid">
      <div class="col-7">
        <p class="eyebrow">What it really costs</p>
        <h2>One price, nothing hidden</h2>
        <p class="lead">{gbp(minPrice)} covers the online HUMAN MOVEMENT course, four or five in-person days, your manual, the video library, every workshop and the exams. Studio hire for practice teaching and insurance are the only things to budget for on top.</p>
        <p class="mt-4"><a href="/pricing" class="arrow-link">See pricing and payment options</a></p>
      </div>
      <div class="col-5"><AccreditationStrip settings={settings} /></div>
    </div>
  </Section>

  {graduates.length > 0 && (
    <Section tone="subtle">
      <header class="section-heading"><p class="eyebrow">Outcomes</p><h2>Where our graduates teach</h2></header>
      <ul class="grad-strip" role="list">{graduates.slice(0, 6).map((g) => <li><strong>{g.name}</strong><span class="small muted">{[g.course, g.studios?.join(', '), g.town].filter(Boolean).join(' · ')}</span></li>)}</ul>
      <p class="mt-6"><a href="/graduates" class="arrow-link">All graduate profiles</a></p>
    </Section>
  )}
  <Testimonials items={testimonials.slice(0, 3)} linkHref="/graduates" />

  <Section id="dates">
    <header class="section-heading"><p class="eyebrow">Upcoming dates</p><h2>Next cohorts</h2></header>
    <DatesList dates={dates} courses={courses} showCourse emptyText="New teacher training dates are being scheduled." />
    <p class="mt-6"><a href="/course-dates" class="arrow-link">All course dates</a></p>
  </Section>

  <Section tone="subtle"><FaqAccordion faqs={faqs} heading="Questions about training with us" /></Section>

  <Section tone="inverse">
    <div class="grid">
      <div class="col-7"><p class="eyebrow">Free guide</p><h2>{settings.freeGuide.title}</h2></div>
      <div class="col-5"><EmailCapture formId="qualify_guide" path="qualify" tag="career-guide" successText="Thanks. The guide is on its way to your inbox." /></div>
    </div>
  </Section>
</Base>
<style>
  .section-heading { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); }
  .col-7 { grid-column: span 12; } .col-5 { grid-column: span 12; }
  @media (min-width: 1024px) { .col-7 { grid-column: span 7; } .col-5 { grid-column: 9 / span 4; } }
  .card-grid { list-style: none; display: grid; gap: var(--space-7); }
  @media (min-width: 768px) { .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); } }
  .table-wrap { overflow-x: auto; }
  table th[scope="row"] { font-weight: var(--weight-medium); white-space: nowrap; }
  td { color: var(--text-secondary); }
  .grad-strip { list-style: none; display: grid; gap: var(--space-4); }
  @media (min-width: 768px) { .grad-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grad-strip li { display: grid; gap: var(--space-1); border-top: var(--border-width) solid var(--border-subtle); padding-top: var(--space-3); }
  .mt-4 { margin-top: var(--space-4); } .mt-6 { margin-top: var(--space-6); }
</style>
