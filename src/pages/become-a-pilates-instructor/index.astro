---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import FactsBlock from '@/components/FactsBlock.astro';
import Timeline from '@/components/Timeline.astro';
import CourseCard from '@/components/CourseCard.astro';
import DatesList from '@/components/DatesList.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import EmailCapture from '@/components/EmailCapture.astro';
import Testimonials from '@/components/Testimonials.astro';
import AccreditationStrip from '@/components/AccreditationStrip.astro';
import { getSiteSettings, getQualifyCourses, getUpcomingDates, getPricingRules, getFaqsByIds, getTestimonials, getGraduates } from '@/lib/content';
import { gbp } from '@/lib/format';

const [settings, courses, allDates, rules, faqs, testimonials, graduates] = await Promise.all([
  getSiteSettings(), getQualifyCourses(), getUpcomingDates(), getPricingRules(),
  getFaqsByIds(['faq-cost', 'faq-how-long', 'faq-hours', 'faq-mat-reformer-first', 'faq-mat-experience', 'faq-reformer-access', 'faq-accreditation', 'faq-finance']),
  getTestimonials(), getGraduates(),
]);
const ids = new Set(courses.map((c) => c._id));
const dates = allDates.filter((d) => ids.has(d.course)).slice(0, 6);
const nextFor = (id: string) => allDates.find((d) => d.course === id);
const dbl = rules.find((r) => r.slug === 'double-booking');
const mat = courses.find((c) => c.slug === 'mat-pilates-teacher-training');
const reformer = courses.find((c) => c.slug === 'reformer-pilates-teacher-training');
const minPrice = Math.min(...courses.map((c) => c.price ?? Infinity));
const answer = `To become a Pilates instructor in Manchester you complete a teacher training course, supported practice hours and exams. At The Pilates Programme, Altrincham that is five in-person days, 80 practice hours and three exams, from ${gbp(minPrice)} all in with four interest-free payments. Most students teach their first paid class within three to four months.`;
const steps = [
  { title: 'Choose your course', text: 'Mat, Reformer or Barre. Take the quiz if you are unsure, or book two together and save £1,000.', meta: 'Week 0' },
  { title: '5-day in-person intensive', text: 'Small cohort, individual coaching at the Altrincham centre, after the online Human Movement course.', meta: 'Weeks 1 to 4' },
  { title: 'Practice hours with support', text: '30 observation, 25 personal study and 25 practice teaching hours, with a plan and your trainers on hand.', meta: 'Weeks 5 to 12' },
  { title: 'Exams and your first class', text: 'Two online multiple choice exams and a practical over Zoom, all included. Then cover, apply or launch your own.', meta: 'Weeks 12 to 16' },
];
const facts = [
  { label: 'Courses', value: 'Mat, Reformer, Barre' },
  { label: 'In-person days', value: '5 per course' },
  { label: 'Practice hours', value: '80 supported' },
  { label: 'Exams', value: '3, included' },
  { label: 'Price', value: `${gbp(minPrice)} or 4 × ${gbp(minPrice / 4)}` },
  { label: 'Location', value: 'Altrincham, Greater Manchester' },
  { label: 'Accreditation', value: 'ITTAP via PMA · CIMSPA Training Partner' },
  { label: 'Prerequisite', value: 'None' },
];
---
<Base title="How to Become a Pilates Instructor in Manchester | The Pilates Programme" description="The route to qualifying as a Pilates or Barre teacher in Manchester: 5 in-person days, 80 supported hours and exams included, from £2,200. Small cohorts in Altrincham.">
  <Hero eyebrow="Qualify" title="How to become a Pilates instructor in Manchester" lead="One route, no shortcuts: a 5-day in-person intensive, supported practice hours and exams that studios trust. Everything included in one price.">
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'Become a Pilates instructor', url: '/become-a-pilates-instructor' }]} />
    <div class="hero-actions">
      <a href="#courses" class="btn btn-primary">Choose a course</a>
      <a href="/become-a-pilates-instructor/which-course" class="btn btn-secondary">Take the 60-second quiz</a>
    </div>
  </Hero>

  <Section>
    <div class="grid">
      <div class="col-7"><AnswerBox question="How do you become a Pilates instructor?" answer={answer} /></div>
      <div class="col-5"><FactsBlock facts={facts} /></div>
    </div>
  </Section>

  <Section tone="subtle">
    <header class="section-heading"><p class="eyebrow">Your route</p><h2>Your route in 4 steps</h2></header>
    <Timeline steps={steps} />
  </Section>

  <Section id="courses">
    <header class="section-heading"><p class="eyebrow">Teacher training</p><h2>Choose your first course</h2></header>
    <ul class="card-grid" role="list" data-stagger>{courses.map((c) => <li><CourseCard course={c} nextDate={nextFor(c._id)} showBestFor /></li>)}</ul>
  </Section>

  {mat && reformer && (
    <Section tone="subtle">
      <header class="section-heading"><p class="eyebrow">Which first?</p><h2>Mat or Reformer first?</h2><p class="lead">Both qualify you to teach. The difference is where you want to teach and what you can practise on.</p></header>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Question</th><th scope="col">Mat</th><th scope="col">Reformer</th></tr></thead>
          <tbody>
            <tr><th scope="row">Prerequisites</th><td>{mat.prerequisites?.length ? mat.prerequisites.join(', ') : 'None'}</td><td>{reformer.prerequisites?.length ? reformer.prerequisites.join(', ') : 'None'}</td></tr>
            <tr><th scope="row">Equipment for practice hours</th><td>None. A mat and a room.</td><td>Regular access to a Reformer: local studio, hire at the centre, or at home.</td></tr>
            <tr><th scope="row">Where you can teach</th><td>Studios, gyms, community venues, online, your own classes.</td><td>Boutique Reformer studios and gyms with Reformers, private clients.</td></tr>
            <tr><th scope="row">Price</th><td>{gbp(mat.price)}</td><td>{gbp(reformer.price)}</td></tr>
            <tr><th scope="row">Levels covered</th><td>{mat.level}</td><td>{reformer.level}</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small muted mt-4">Job demand varies by area. The jobs board shows which disciplines local studios are hiring for right now.</p>
    </Section>
  )}

  {dbl && (
    <Section tone="inverse">
      <div class="grid">
        <div class="col-7"><p class="eyebrow">Double booking</p><h2>Two courses, {gbp(dbl.amount)}. Save {gbp(dbl.saving)}.</h2></div>
        <div class="col-5"><p class="lead">{dbl.summary} {dbl.detail}</p><p class="mt-4"><a href="/pricing" class="arrow-link">See how it works</a></p></div>
      </div>
    </Section>
  )}

  <Section>
    <div class="grid">
      <div class="col-7">
        <p class="eyebrow">What it really costs</p>
        <h2>One price, nothing hidden</h2>
        <p class="lead">{gbp(minPrice)} covers the online course, five in-person days, your manual, the video library, every workshop and all three exams. Studio hire for practice hours and insurance are the only things to budget for on top.</p>
        <p class="mt-4"><a href="/pricing" class="arrow-link">See the full pricing, finance and payback maths</a></p>
      </div>
      <div class="col-5"><AccreditationStrip settings={settings} /></div>
    </div>
  </Section>

  {graduates.length > 0 && (
    <Section tone="subtle">
      <header class="section-heading"><p class="eyebrow">Outcomes</p><h2>Where our graduates teach</h2></header>
      <ul class="grad-strip" role="list">{graduates.slice(0, 6).map((g) => <li><strong>{g.name}</strong><span class="small muted">{[g.course, g.studios?.join(', '), g.town].filter(Boolean).join(' · ')}</span></li>)}</ul>
      <p class="mt-6"><a href="/graduates" class="arrow-link">All graduate profiles</a></p>
    </Section>
  )}
  <Testimonials items={testimonials.slice(0, 3)} linkHref="/graduates" />

  <Section id="dates">
    <header class="section-heading"><p class="eyebrow">Upcoming dates</p><h2>Next cohorts</h2></header>
    <DatesList dates={dates} courses={courses} showCourse emptyText="New teacher training dates are being scheduled." />
    <p class="mt-6"><a href="/course-dates" class="arrow-link">All course dates</a></p>
  </Section>

  <Section tone="subtle"><FaqAccordion faqs={faqs} heading="Questions about qualifying" /></Section>

  <Section tone="inverse">
    <div class="grid">
      <div class="col-7"><p class="eyebrow">Free guide</p><h2>{settings.freeGuide.title}</h2></div>
      <div class="col-5"><EmailCapture formId="qualify_guide" path="qualify" tag="career-guide" successText="Thanks. The guide is on its way to your inbox." /></div>
    </div>
  </Section>
</Base>
<style>
  .section-heading { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); }
  .col-7 { grid-column: span 12; } .col-5 { grid-column: span 12; }
  @media (min-width: 1024px) { .col-7 { grid-column: span 7; } .col-5 { grid-column: 9 / span 4; } }
  .card-grid { list-style: none; display: grid; gap: var(--space-7); }
  @media (min-width: 768px) { .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); } }
  .table-wrap { overflow-x: auto; }
  table th[scope="row"] { font-weight: var(--weight-medium); white-space: nowrap; }
  td { color: var(--text-secondary); }
  .grad-strip { list-style: none; display: grid; gap: var(--space-4); }
  @media (min-width: 768px) { .grad-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grad-strip li { display: grid; gap: var(--space-1); border-top: var(--border-width) solid var(--border-subtle); padding-top: var(--space-3); }
  .mt-4 { margin-top: var(--space-4); } .mt-6 { margin-top: var(--space-6); }
</style>
