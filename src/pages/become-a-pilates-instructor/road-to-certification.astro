---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Timeline from '@/components/Timeline.astro';
import HoursBar from '@/components/HoursBar.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import EmailCapture from '@/components/EmailCapture.astro';
import { getSiteSettings, getQualifyCourses, getFaqsByIds } from '@/lib/content';
import { gbp } from '@/lib/format';
const [settings, courses, faqs] = await Promise.all([getSiteSettings(), getQualifyCourses(), getFaqsByIds(['faq-how-long', 'faq-hours', 'faq-exams', 'faq-studio-hire', 'faq-reformer-access'])]);
const hours = courses[0]?.hoursBreakdown ?? { observation: 30, personalStudy: 25, practiceTeaching: 25 };
const exams = courses[0]?.exams ?? [];
// Time to certify: usually around 6 months, anywhere from 3 to 12 (client, 8 Oct 2026). Never weeks.
const timeline = [
  { meta: 'Step 1', title: 'You book', text: 'Welcome email, online platform access and the HUMAN MOVEMENT course, sent to you to start working through as soon as you sign up.' },
  { meta: 'Step 2', title: 'Pre-course study', text: 'Work through the HUMAN MOVEMENT course and your pre-reading at your own pace, around work.' },
  { meta: 'Step 3', title: '4 or 5 in-person days', text: 'Repertoire, teaching skills and workshops in a small cohort, usually at our Altrincham training centre.' },
  { meta: 'Step 4', title: 'Your practice hours', text: 'Observation, personal study and practice teaching, in your own time and at a location that works for you.' },
  { meta: 'Step 5', title: 'The exams', text: 'Once your hours are logged and you feel confident with your teaching. All online, all included.' },
  { meta: 'Step 6', title: 'Your first paid class', text: 'Cover at a local studio, apply through the jobs board, or launch your own class. Industry ready from day one.' },
];
---
<Base title="Road to Certification | The Pilates Programme" description="How you become a certified Pilates instructor: the in-person days, the practice hours around your life, and the exams. Usually around six months.">
  <Hero eyebrow="Road to Certification" title="How long does it take to become a Pilates instructor?" lead="Most of our students certify in around six months. Some do it in three, some take up to twelve, and both are fine. Here is what fills that time, and why studios hire our graduates.">
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'Become a Pilates instructor', url: '/become-a-pilates-instructor' }, { name: 'Road to Certification', url: '/become-a-pilates-instructor/road-to-certification' }]} />
  </Hero>

  <Section>
    <AnswerBox question="How long does it take to become a Pilates instructor?" answer="With The Pilates Programme it is usually around six months, and anywhere from three to twelve. You work through the online HUMAN MOVEMENT course, complete four or five in-person days, then do your 30 observation, 25 personal study and 25 practice teaching hours in your own time, around your job and your family, before sitting the exams online." />
  </Section>

  <Section tone="subtle">
    <header class="section-heading"><p class="eyebrow">Timeline</p><h2>From booking to your first paid class</h2></header>
    <Timeline steps={timeline} />
  </Section>

  <Section>
    <div class="grid">
      <div class="col-7">
        <header class="section-heading"><p class="eyebrow">The hours</p><h2>Why the practice hours matter</h2><p class="lead">Because knowing the exercises is not the same as teaching them. These hours mean that once you pass your exams you are industry ready and can teach confidently and competently in a studio. Our students are sought after because they already have hands-on experience teaching real clients.</p></header>
        <ul class="rule-list hours-list" role="list">
          <li><strong>{hours.observation} observation hours.</strong> Observing other teachers, on our online platform or by attending classes.</li>
          <li><strong>{hours.personalStudy} personal study hours.</strong> Practising every exercise in the manual on your own body and understanding them inside out.</li>
          <li><strong>{hours.practiceTeaching} practice teaching hours.</strong> Planning and delivering practice classes.</li>
        </ul>
        <HoursBar hours={hours} />
      </div>
      <div class="col-5">
        <h3>How the hours fit around your life</h3>
        <p class="secondary">You complete them in your own time, at a location that works for you: around your existing nine to five, your family and everything else going on. Observation can be in person or through the video library. Practice teaching can be friends, family or fellow students. If you need a room and equipment, hire the centre.</p>
        <ul class="rule-list how-list mt-4" role="list">
          <li><strong>Studio hire.</strong> {settings.studioHireRate ? `${gbp(settings.studioHireRate)} per hour at the Altrincham centre for practice teaching.` : 'At the Altrincham centre, for practice teaching. Ask us for the current rate.'}</li>
          <li><strong>Equipment hire.</strong> At the centre, for your personal practice.</li>
          <li><strong>Your local studio.</strong> Ask whether you can observe classes or hire their space.</li>
          <li><strong>Online observation.</strong> Through the video library{settings.appMonthlyPrice ? ` and the app (${gbp(settings.appMonthlyPrice)} a month)` : ''}.</li>
        </ul>
      </div>
    </div>
  </Section>

  <Section tone="subtle">
    <header class="section-heading"><p class="eyebrow">Exams</p><h2>What are the exams?</h2><p class="lead">All online, all included in the course fee, and we structure the course so you are ready for each one.</p></header>
    <ol class="exam-list" role="list" data-stagger>{exams.map((e) => <li><h3>{e.title}</h3><p class="secondary">{e.detail}</p></li>)}</ol>
  </Section>

  <Section>
    <header class="section-heading"><p class="eyebrow">Support</p><h2>You will never figure it out alone</h2></header>
    <ul class="support-grid" role="list" data-stagger>
      <li><h3>Your trainers</h3><p class="secondary">Georgie, Sarah and the team are on the end of the phone throughout your hours, and at the centre. An actual person, every time.</p></li>
      <li><h3>The online platform</h3><p class="secondary">Manual, video library and revision material, which you keep after you certify.</p></li>
      <li><h3>The centre</h3><p class="secondary">Studio and equipment hire for practice teaching and personal practice.</p></li>
      <li><h3>Your cohort</h3><p class="secondary">Small groups mean you practise teaching on each other, keep each other going and make new friends.</p></li>
    </ul>
  </Section>

  <Section tone="subtle"><FaqAccordion faqs={faqs} heading="Questions about hours and exams" /></Section>

  <Section tone="inverse">
    <div class="grid">
      <div class="col-7"><p class="eyebrow">Ready?</p><h2>Choose your first course</h2><p class="lead">Mat, Reformer or Barre. Four or five in-person days, your practice hours in your own time, exams included.</p><div class="hero-actions"><a href="/become-a-pilates-instructor#courses" class="btn btn-primary">See the courses</a><a href="/course-dates" class="btn btn-secondary">See dates</a></div></div>
      <div class="col-5"><EmailCapture formId="road_guide" path="qualify" tag="career-guide" heading="Or get the free guide first" successText="Thanks. The guide is on its way to your inbox." /></div>
    </div>
  </Section>
</Base>
<style>
  .section-heading { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); }
  .col-7 { grid-column: span 12; } .col-5 { grid-column: span 12; }
  @media (min-width: 1024px) { .col-7 { grid-column: span 7; } .col-5 { grid-column: 9 / span 4; } }
  .how-list, .hours-list { list-style: none; } .how-list li, .hours-list li { padding-block: var(--space-3); color: var(--text-secondary); }
  .hours-list { margin-bottom: var(--space-5); }
  .exam-list { list-style: none; display: grid; gap: var(--space-5); }
  @media (min-width: 768px) { .exam-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .exam-list li { display: grid; gap: var(--space-2); border-top: var(--border-width) solid var(--border-strong); padding-top: var(--space-4); }
  .support-grid { list-style: none; display: grid; gap: var(--space-5); }
  @media (min-width: 768px) { .support-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .support-grid li { display: grid; gap: var(--space-2); border-top: var(--border-width) solid var(--border-subtle); padding-top: var(--space-4); }
  .mt-4 { margin-top: var(--space-4); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
</style>
