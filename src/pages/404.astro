---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
---
<Base title="Page Not Found | The Pilates Programme" description="This page has moved. Find teacher training, continuing education and course dates from The Pilates Programme, Altrincham." noindex>
  <div data-page-event='{"event":"page_not_found"}' hidden></div>
  <Section>
    <p class="eyebrow">404</p>
    <h1>This page has moved.</h1>
    <p class="lead">The site was rebuilt in 2026 and some addresses changed. Try one of these, or search the FAQs.</p>
    <div class="paths">
      <a href="/become-a-pilates-instructor" class="btn btn-primary">I want to qualify</a>
      <a href="/continuing-education" class="btn btn-secondary">I'm already a teacher</a>
      <a href="/course-dates" class="btn btn-secondary">Course dates</a>
    </div>
    <form action="/faqs" method="get" class="search" role="search">
      <label for="s" class="visually-hidden">Search questions</label>
      <input class="input" id="s" name="q" type="search" placeholder="Search the FAQs" />
      <button type="submit" class="btn btn-secondary">Search</button>
    </form>
  </Section>
</Base>
<style>
  h1 { margin-block: var(--space-3) var(--space-4); }
  .paths { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .search { display: grid; gap: var(--space-2); margin-top: var(--space-7); max-width: var(--measure-body); }
  @media (min-width: 768px) { .search { grid-template-columns: 1fr auto; } }
</style>
<script>
  // Pass a search query through to the FAQ search box.
  const q = new URLSearchParams(location.search).get('q');
  if (q && location.pathname === '/faqs') { const i = document.getElementById('faq-search') as HTMLInputElement | null; if (i) { i.value = q; i.dispatchEvent(new Event('input')); } }
</script>
