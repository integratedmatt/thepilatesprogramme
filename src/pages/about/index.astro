---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TeamCards from '@/components/TeamCards.astro';
import Picture from '@/components/Picture.astro';
import AccreditationStrip from '@/components/AccreditationStrip.astro';
import { getSiteSettings, getTeam } from '@/lib/content';
const [settings, team] = await Promise.all([getSiteSettings(), getTeam()]);
const founders = team.filter((m) => m.founder);
const trainers = team.filter((m) => !m.founder);
---
<Base title="About The Pilates Programme, Altrincham | The Pilates Programme" description="Founded by Georgie and Sarah to fix what they missed when they qualified: small cohorts, in-person coaching and every Pilates tradition, taught in Altrincham.">
  <Hero eyebrow="About" title="Built by teachers who wanted a better training" lead="The Pilates Programme, Altrincham was founded by Georgie and Sarah to close the gaps they felt when they qualified: too little time in the room, one style only, and no help finding work.">
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'About', url: '/about' }]} />
  </Hero>

  <Section>
    <div class="grid">
      <div class="col-7"><Picture image={{ url: '/images/site/about-8.jpg', alt: 'The lounge at the Altrincham training centre, with the words Be you not them on the wall', width: 1600, height: 1068 }} aspect="landscape" sizes="(min-width: 1024px) 58vw, 100vw" /></div>
      <div class="col-5">
        <p class="eyebrow">Our story</p>
        <h2>Why we built the course</h2>
        <p class="secondary">We qualified through courses that taught a sequence and sent us on our way. What we needed was more time with a trainer watching us teach, a method that covered every tradition so we could work anywhere, and a plan for the practice hours and the first job. So we built that.</p>
        <p class="secondary mt-4">Today we train small cohorts from a two-floor centre in Altrincham, with full apparatus, and we stay with students long after the course through studio hire, CPD and the jobs board.</p>
      </div>
    </div>
  </Section>

  <Section tone="subtle"><TeamCards members={founders} heading="The founders" /></Section>
  {trainers.length > 0 && <Section><TeamCards members={trainers} heading="The trainer team" /></Section>}

  <Section tone="inverse">
    <header class="section-heading"><p class="eyebrow">Values</p><h2>What we stand for</h2></header>
    <ul class="values" role="list" data-stagger>
      <li><h3>Quality over speed</h3><p>The hours exist because they make you a teacher studios trust. We will never sell a guaranteed pass.</p></li>
      <li><h3>In person, in a small group</h3><p>Being corrected while you teach is the fastest way to improve. Online supports it, it never replaces it.</p></li>
      <li><h3>The whole method</h3><p>Contrology, Classical and Contemporary, so you can teach in any studio and understand why each tradition exists.</p></li>
      <li><h3>Community that lasts</h3><p>Graduates come back for apparatus courses and CPD, refer friends and hire each other.</p></li>
    </ul>
  </Section>

  <Section>
    <div class="grid">
      <div class="col-5"><p class="eyebrow">Method lineage</p><h2>From Contrology to today</h2></div>
      <div class="col-7">
        <p class="secondary">Joseph Pilates called his work Contrology and built it around a set of original exercises and apparatus. The Classical tradition preserves that order and intention. Contemporary Pilates adapts it with modern movement science, props and variations. We teach all three, in that order, so you understand the roots before you adapt them.</p>
        <p class="mt-4"><a href="/accreditation" class="arrow-link">How our training is accredited</a></p>
      </div>
    </div>
  </Section>

  <Section tone="subtle">
    <div class="grid">
      <div class="col-5"><p class="eyebrow">Elevating Others</p><h2>Two funded places a year</h2></div>
      <div class="col-7"><p class="secondary">Every year we fully fund two Mat teacher trainings for people who face barriers to access. <a href="/elevating-others">Read about Elevating Others</a>.</p><div class="mt-6"><AccreditationStrip settings={settings} /></div></div>
    </div>
  </Section>
</Base>
<style>
  .section-heading { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); }
  .col-7 { grid-column: span 12; } .col-5 { grid-column: span 12; }
  @media (min-width: 1024px) { .col-7 { grid-column: span 7; } .col-5 { grid-column: 9 / span 4; } .grid > .col-5:first-child { grid-column: span 4; } .grid > .col-5:first-child + .col-7 { grid-column: 6 / span 7; } }
  .col-5 h2 { margin-block: var(--space-3) var(--space-4); }
  .values { list-style: none; display: grid; gap: var(--space-6); }
  @media (min-width: 768px) { .values { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .values li { display: grid; gap: var(--space-2); border-top: var(--border-width) solid var(--ink-700); padding-top: var(--space-4); }
  .values p { color: var(--stone-300); }
  .mt-4 { margin-top: var(--space-4); } .mt-6 { margin-top: var(--space-6); }
</style>
