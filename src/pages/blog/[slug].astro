---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Picture from '@/components/Picture.astro';
import PostCard from '@/components/PostCard.astro';
import CourseCard from '@/components/CourseCard.astro';
import EmailCapture from '@/components/EmailCapture.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getPosts, getSiteSettings, getCourses, getUpcomingDates } from '@/lib/content';
import { articleSchema } from '@/lib/schema';
import { longDate, readingTime, wordCount, slugify } from '@/lib/format';
import { pageTitle, pageDescription } from '@/lib/seo';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const [settings, posts, courses, dates] = await Promise.all([getSiteSettings(), getPosts(), getCourses(), getUpcomingDates()]);
const siteUrl = Astro.site?.origin ?? 'https://www.thepilatesprogramme.co.uk';
const url = `/blog/${post.slug}`;
const words = wordCount(post.body);
const showToc = words > 1200;
// Add ids to h2s for the table of contents and split the body for the inline CTA at ~40% depth.
const headings: { id: string; text: string }[] = [];
let body = post.body.replace(/<h2>(.*?)<\/h2>/g, (_, text) => { const id = slugify(text.replace(/<[^>]+>/g, '')); headings.push({ id, text: text.replace(/<[^>]+>/g, '') }); return `<h2 id="${id}">${text}</h2>`; });
const blocks = body.split(/(?=<h2)/);
const cut = Math.max(1, Math.round(blocks.length * 0.4));
const before = blocks.slice(0, cut).join('');
const after = blocks.slice(cut).join('');
const related = (post.relatedCourses ?? []).map((s) => courses.find((c) => c.slug === s)).filter((c): c is NonNullable<typeof c> => Boolean(c)).slice(0, 3);
const ctaCourse = related[0];
const relatedPosts = posts.filter((p) => p.slug !== post.slug && p.category?.slug === post.category?.slug).slice(0, 3);
const morePosts = relatedPosts.length ? relatedPosts : posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const nextFor = (id: string) => dates.find((d) => d.course === id);
---
<Base title={pageTitle(post.title, post.seo)} description={pageDescription(post.summary.slice(0, 155), post.seo)} ogImage={post.seo.ogImage?.url ?? post.image?.url} ogType="article" bodyClass="post-page">
  <Fragment slot="head"><JsonLd data={articleSchema(post, settings, siteUrl, url)} /></Fragment>
  <div data-track="scroll" hidden></div>
  <article>
    <header class="post-header">
      <div class="container post-head-inner">
        <Breadcrumbs items={[{ name: 'Journal', url: '/blog' }, { name: post.category?.title ?? 'Article', url: `/blog/category/${post.category?.slug}` }, { name: post.title, url }]} />
        <p class="eyebrow">{post.category?.title}</p>
        <h1>{post.title}</h1>
        <p class="byline small muted">By <a href={`/about/${post.author?.slug}`}>{post.author?.name}</a>{post.author?.role ? `, ${post.author.role}` : ''} · Published <time datetime={post.publishedAt}>{longDate(post.publishedAt)}</time>{post.updatedAt && post.updatedAt !== post.publishedAt ? <> · Updated <time datetime={post.updatedAt}>{longDate(post.updatedAt)}</time></> : null} · {readingTime(post.body)} min read</p>
      </div>
    </header>
    {post.image && <div class="container"><Picture image={post.image} aspect="landscape" sizes="(min-width: 1280px) 1232px, 100vw" priority /></div>}
    <Section reveal={false}>
      <div class="post-grid">
        <aside class="post-side">
          <div class="summary"><p class="eyebrow">In short</p><p>{post.summary}</p></div>
          {showToc && <nav class="toc" aria-label="Contents"><p class="eyebrow">Contents</p><ol role="list">{headings.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol></nav>}
        </aside>
        <div class="post-body prose">
          <Fragment set:html={before} />
          {ctaCourse && (
            <aside class="inline-cta" aria-label="Related course">
              <p class="eyebrow">Related course</p>
              <p class="h3">{ctaCourse.title}</p>
              <p>{ctaCourse.outcome}</p>
              <a href={ctaCourse.path === 'qualify' ? `/become-a-pilates-instructor/${ctaCourse.slug}` : ctaCourse.kind === 'cpd' ? `/continuing-education/cpd/${ctaCourse.slug}` : `/continuing-education/${ctaCourse.slug}`} class="btn btn-primary">See the course</a>
            </aside>
          )}
          <Fragment set:html={after} />
          <footer class="author-box">
            {post.author?.image && <Picture image={post.author.image} aspect="square" sizes="96px" widths={[96, 192]} class="author-img" />}
            <div><p class="eyebrow">About the author</p><p><strong><a href={`/about/${post.author?.slug}`}>{post.author?.name}</a></strong>{post.author?.role ? `, ${post.author.role}` : ''}</p>{post.author?.credentials?.length ? <p class="small muted">{post.author.credentials.join(' · ')}</p> : null}{post.author?.bio && <p class="small">{post.author.bio}</p>}</div>
          </footer>
        </div>
      </div>
    </Section>
  </article>
  {related.length > 0 && (
    <Section tone="subtle">
      <header class="section-heading"><p class="eyebrow">Related courses</p><h2>Train with the people who wrote this</h2></header>
      <ul class="card-grid" role="list" data-stagger>{related.map((c) => <li><CourseCard course={c} nextDate={nextFor(c._id)} /></li>)}</ul>
    </Section>
  )}
  {morePosts.length > 0 && (
    <Section>
      <header class="section-heading"><p class="eyebrow">Keep reading</p><h2>Related articles</h2></header>
      <ul class="card-grid" role="list" data-stagger>{morePosts.map((p) => <li><PostCard post={p} /></li>)}</ul>
    </Section>
  )}
  <Section tone="inverse">
    <div class="grid"><div class="col-7"><p class="eyebrow">Free guide</p><h2>{settings.freeGuide.title}</h2></div><div class="col-5"><EmailCapture formId={`post_${post.slug}`} path="qualify" tag="career-guide" successText="Thanks. The guide is on its way to your inbox." /></div></div>
  </Section>
</Base>
<style>
  .post-header { padding-block: var(--space-8) var(--space-6); }
  @media (min-width: 768px) { .post-header { padding-top: var(--space-9); } }
  .post-head-inner { display: grid; gap: var(--space-4); }
  .post-head-inner h1 { max-width: var(--measure-heading); }
  .post-grid { display: grid; gap: var(--space-7); }
  @media (min-width: 1024px) { .post-grid { grid-template-columns: 3fr 8fr; gap: var(--space-8); } }
  .post-side { display: grid; gap: var(--space-6); align-content: start; }
  @media (min-width: 1024px) { .post-side { position: sticky; top: calc(var(--header-height) + var(--space-5)); } }
  .summary { border: var(--border-width) solid var(--border-strong); padding: var(--space-5); background: var(--bg-surface); display: grid; gap: var(--space-2); }
  .toc ol { list-style: none; display: grid; gap: var(--space-2); font-size: var(--type-small); margin-top: var(--space-2); }
  .toc a { color: var(--text-secondary); text-decoration: none; } .toc a:hover { color: var(--text-link); text-decoration: underline; }
  .post-body { max-width: var(--measure-body); }
  .inline-cta { margin-block: var(--space-7); padding: var(--space-6); background: var(--bg-subtle); border-left: var(--focus-width) solid var(--bronze-700); display: grid; gap: var(--space-3); justify-items: start; }
  .author-box { margin-top: var(--space-8); padding-top: var(--space-6); border-top: var(--border-width) solid var(--border-subtle); display: grid; gap: var(--space-4); }
  @media (min-width: 768px) { .author-box { grid-template-columns: auto 1fr; } }
  :global(.author-img) { width: var(--space-9); }
  .section-heading { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); }
  .card-grid { list-style: none; display: grid; gap: var(--space-7); }
  @media (min-width: 768px) { .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); } }
  .col-7 { grid-column: span 12; } .col-5 { grid-column: span 12; }
  @media (min-width: 1024px) { .col-7 { grid-column: span 7; } .col-5 { grid-column: 9 / span 4; } }
</style>
