---
import BlogIndex from '@/components/BlogIndex.astro';
import { getPosts, getCategories } from '@/lib/content';
const PER_PAGE = 10;
export async function getStaticPaths() {
  const posts = await getPosts();
  const total = Math.ceil(posts.length / 10);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const page = Number(Astro.params.page);
const [posts, categories] = await Promise.all([getPosts(), getCategories()]);
---
<BlogIndex posts={posts.slice((page - 1) * PER_PAGE, page * PER_PAGE)} categories={categories} page={page} totalPages={Math.ceil(posts.length / PER_PAGE)} basePath="/blog" />
