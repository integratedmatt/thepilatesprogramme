---
import CoursePage from '@/components/CoursePage.astro';
import { getContinueCourses } from '@/lib/content';
export async function getStaticPaths() {
  const courses = (await getContinueCourses()).filter((c) => c.kind !== 'cpd');
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}
const { course } = Astro.props;
---
<CoursePage course={course} />
