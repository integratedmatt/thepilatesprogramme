---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import CourseCard from '@/components/CourseCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { getCpdCourses, getUpcomingDates, getFaqsByIds } from '@/lib/content';
const [cpd, dates, faqs] = await Promise.all([getCpdCourses(), getUpcomingDates(), getFaqsByIds(['faq-cpd-who', 'faq-cpd-online', 'faq-cpd-finance', 'faq-returning-discount'])]);
const nextFor = (id: string) => dates.find((d) => d.course === id);
---
<Base title="Pilates CPD Courses UK | The Pilates Programme" description="One-day Pilates CPD for qualified teachers from any provider: prenatal and postpartum, strength and endurance, jumpboard online and pain science. £250 each in Altrincham.">
  <Hero eyebrow="CPD" title="Pilates CPD courses for working teachers" lead="One day, one topic, taught by trainers who teach every week. Open to Pilates and Barre teachers from any provider.">
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'Continuing education', url: '/continuing-education' }, { name: 'CPD', url: '/continuing-education/cpd' }]} />
  </Hero>
  <Section><AnswerBox question="What CPD do you run?" answer="The Pilates Programme, Altrincham runs one-day CPD courses for qualified Pilates and Barre teachers from any provider, at £250 each or two interest-free instalments: Prenatal and Postpartum, Strength and Endurance and Pain Science in person at our training centre, and Jumpboard online on demand. Past students receive 10% off." /></Section>
  <Section tone="subtle">
    <ul class="card-grid" role="list">{cpd.map((c) => <li><CourseCard course={c} nextDate={nextFor(c._id)} showBestFor /></li>)}</ul>
  </Section>
  <Section><FaqAccordion faqs={faqs} heading="CPD questions" /></Section>
</Base>
<style>
  .card-grid { list-style: none; display: grid; gap: var(--space-7); }
  @media (min-width: 768px) { .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); } }
  @media (min-width: 1024px) { .card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
