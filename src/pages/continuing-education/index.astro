---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import CourseCard from '@/components/CourseCard.astro';
import DatesList from '@/components/DatesList.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import JobRow from '@/components/JobRow.astro';
import { getSiteSettings, getContinueCourses, getUpcomingDates, getPricingRules, getFaqsByIds, getLiveJobs, courseUrl } from '@/lib/content';
import { gbp } from '@/lib/format';
const [settings, courses, allDates, rules, faqs, jobs] = await Promise.all([getSiteSettings(), getContinueCourses(), getUpcomingDates(), getPricingRules(), getFaqsByIds(['faq-prereq-apparatus', 'faq-bundle', 'faq-returning-discount', 'faq-cpd-who', 'faq-cpd-finance']), getLiveJobs()]);
const included = settings.continueInclusions ?? [];
const apparatus = courses.filter((c) => c.kind === 'apparatus');
const bundle = courses.find((c) => c.kind === 'bundle');
const cpd = courses.filter((c) => c.kind === 'cpd');
const ids = new Set(courses.map((c) => c._id));
const dates = allDates.filter((d) => ids.has(d.course));
const nextFor = (id: string) => allDates.find((d) => d.course === id);
const returning = rules.find((r) => r.slug === 'returning-student');
const apparatusJobs = jobs.filter((j) => j.disciplines.some((d) => /reformer|chair|cadillac|barrel|apparatus/i.test(d))).slice(0, 3);
const answer = `The Pilates Programme, Altrincham offers continuing education for certified Pilates and Barre teachers from any provider: Advanced Reformer, Chair (£1,200), Cadillac (£1,500) and Barrels (£800), or all three for £2,700 with Barrels free, plus CPD at £250. Every course includes the manual, exams, an interest-free payment plan and online platform access with a 6-week free trial. Past students receive 10% off.`;
---
<Base title="Pilates CPD and Apparatus Courses | The Pilates Programme" description="Advanced Reformer, Chair, Cadillac, Barrels and CPD days for certified Pilates teachers from any provider, in Altrincham. Returning students save 10%.">
  <Hero eyebrow="Continue learning" title="Grow your teaching, grow your income" lead="Apparatus training and CPD for certified teachers from any provider, taught in person on full apparatus in Altrincham.">
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'Continuing education', url: '/continuing-education' }]} />
    <div class="hero-actions"><a href="#apparatus" class="btn btn-primary">Apparatus courses</a><a href="#cpd" class="btn btn-secondary">CPD days</a></div>
  </Hero>

  <Section>
    <div class="grid">
      <div class="col-7"><AnswerBox question="What continuing education do you offer certified teachers?" answer={answer} /></div>
      {included.length > 0 && (
        <div class="col-5">
          <p class="eyebrow">Included in every course</p>
          <ul class="included" role="list" data-stagger>{included.map((i) => <li>{i}</li>)}</ul>
        </div>
      )}
    </div>
  </Section>

  <Section tone="subtle" id="apparatus">
    <header class="section-heading"><p class="eyebrow">Apparatus pathway</p><h2>Teach on every piece of apparatus</h2><p class="lead">Each course requires an existing Mat or Reformer certification. Advanced Reformer requires a Reformer certification. Manual, exam, interest-free instalments and online platform access are included in every course.</p></header>
    <ul class="card-grid" role="list" data-stagger>{apparatus.map((c) => <li><CourseCard course={c} nextDate={nextFor(c._id)} showBestFor /></li>)}</ul>
    {bundle && (
      <div class="bundle">
        <div><p class="eyebrow">Bundle</p><h3>Cadillac, Chair and Barrels together: {gbp(bundle.price)}. Barrels is free.</h3></div>
        <a href={courseUrl(bundle)} class="btn btn-primary">See the bundle</a>
      </div>
    )}
  </Section>

  <Section id="cpd">
    <header class="section-heading"><p class="eyebrow">CPD</p><h2>One-day CPD for working teachers</h2><p class="lead">£250 each, pay in full or in two interest-free instalments. Manual, certificate and online platform access included. In person at the centre, or online on demand.</p></header>
    <ul class="card-grid" role="list" data-stagger>{cpd.map((c) => <li><CourseCard course={c} nextDate={nextFor(c._id)} showBestFor /></li>)}</ul>
  </Section>

  {returning && (
    <Section tone="inverse">
      <div class="grid"><div class="col-7"><p class="eyebrow">Returning students</p><h2>{returning.percent}% off everything above</h2></div><div class="col-5"><p class="lead">{returning.summary}</p><p class="secondary mt-4">{returning.howToClaim}</p></div></div>
    </Section>
  )}

  <Section id="dates">
    <header class="section-heading"><p class="eyebrow">Dates</p><h2>Upcoming continuing education dates</h2></header>
    <DatesList dates={dates} courses={courses} showCourse emptyText="New apparatus and CPD dates are being scheduled." />
  </Section>

  <Section tone="subtle">
    <header class="section-heading"><p class="eyebrow">Jobs board</p><h2>Roles that ask for apparatus skills</h2></header>
    {apparatusJobs.length > 0 ? <ul class="rule-list rule-top rule-bottom jobs" role="list">{apparatusJobs.map((j) => <JobRow job={j} />)}</ul> : <p class="lead">Studios list Reformer and apparatus roles on our jobs board. Check back, or set up job alerts.</p>}
    <p class="mt-6"><a href="/jobs?discipline=Reformer" class="arrow-link">See Reformer and apparatus roles</a></p>
  </Section>

  <Section><FaqAccordion faqs={faqs} heading="Questions from certified teachers" /></Section>
</Base>
<style>
  .section-heading { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); }
  .included { list-style: none; display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  .included li { padding-left: var(--space-5); position: relative; color: var(--text-secondary); font-weight: var(--weight-regular); }
  .included li::before { content: "\2713"; position: absolute; left: 0; color: var(--text-link); font-weight: var(--weight-medium); }
  .card-grid { list-style: none; display: grid; gap: var(--space-7); }
  @media (min-width: 768px) { .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); } }
  @media (min-width: 1024px) { .card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .bundle { display: grid; gap: var(--space-4); margin-top: var(--space-7); padding: var(--space-6); background: var(--bg-surface); border: var(--border-width) solid var(--border-strong); }
  @media (min-width: 768px) { .bundle { grid-template-columns: 1fr auto; align-items: center; } }
  .col-7 { grid-column: span 12; } .col-5 { grid-column: span 12; }
  @media (min-width: 1024px) { .col-7 { grid-column: span 7; } .col-5 { grid-column: 9 / span 4; } }
  .jobs { list-style: none; }
  .mt-4 { margin-top: var(--space-4); } .mt-6 { margin-top: var(--space-6); }
</style>
