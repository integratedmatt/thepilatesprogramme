---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Picture from '@/components/Picture.astro';
import Testimonials from '@/components/Testimonials.astro';
import { getGraduates, getTestimonials, getQualifyCourses, getContinueCourses } from '@/lib/content';
const [graduates, testimonials, qualify, cont] = await Promise.all([getGraduates(), getTestimonials(), getQualifyCourses(), getContinueCourses()]);
const courses = [...qualify, ...cont];
const showGrid = graduates.length >= 6;
const areas = Array.from(new Set(graduates.map((g) => g.town).filter(Boolean))) as string[];
const studios = Array.from(new Set(graduates.flatMap((g) => g.studios ?? []))).sort();
const courseNames = Array.from(new Set(graduates.map((g) => g.course)));
---
<Base title="Where Our Pilates Graduates Teach | The Pilates Programme" description="Where our graduates teach now, how soon they landed their first paid class and what they say about training with The Pilates Programme in Altrincham.">
  <Hero eyebrow="Graduates" title="Where our graduates teach" lead="Outcomes, not promises. Every profile is published with the graduate's consent.">
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'Graduates', url: '/graduates' }]} />
  </Hero>

  {showGrid ? (
    <Section id="profiles" reveal={false}>
      <form class="filters" id="grad-filters" aria-label="Filter graduates">
        <div class="field"><label for="g-course">Course</label><select id="g-course" name="course" class="input"><option value="">All courses</option>{courseNames.map((c) => <option value={c}>{courses.find((x) => x.slug === c)?.shortTitle ?? c}</option>)}</select></div>
        <div class="field"><label for="g-area">Area</label><select id="g-area" name="area" class="input"><option value="">All areas</option>{areas.map((a) => <option value={a}>{a}</option>)}</select></div>
      </form>
      <ul class="grad-grid" role="list" id="grad-list">
        {graduates.map((g) => (
          <li class="grad" data-course={g.course} data-area={g.town ?? ''}>
            {g.image && <Picture image={g.image} aspect="portrait" sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw" />}
            <h3>{g.name}</h3>
            <p class="small muted">{[courses.find((x) => x.slug === g.course)?.shortTitle ?? g.course, g.cohort].filter(Boolean).join(' · ')}</p>
            {g.studios?.length ? <p class="small">Teaches at {g.studios.join(', ')}{g.town ? `, ${g.town}` : ''}</p> : null}
            {g.timeToFirstClass && <p class="small secondary">First class {g.timeToFirstClass} after certifying</p>}
            {g.quote && <p class="secondary">“{g.quote}”</p>}
          </li>
        ))}
      </ul>
      <p class="lead motion-step" id="grad-empty" hidden>No profiles match those filters yet.</p>
      {studios.length > 0 && (
        <div class="studio-list">
          <h2>Studios where our graduates teach</h2>
          <ul role="list">{studios.map((s) => <li>{s}</li>)}</ul>
        </div>
      )}
    </Section>
  ) : (
    <Section>
      <p class="lead">Graduate profiles are coming soon. In the meantime, read what graduates say below.</p>
    </Section>
  )}

  <Testimonials items={testimonials} heading="What graduates say" />

</Base>
<style>
  .filters { display: grid; gap: var(--space-4); margin-bottom: var(--space-6); max-width: calc(var(--space-11) * 3); }
  @media (min-width: 768px) { .filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .grad-grid { list-style: none; display: grid; gap: var(--space-7); }
  @media (min-width: 768px) { .grad-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); } }
  @media (min-width: 1024px) { .grad-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .grad { display: grid; gap: var(--space-2); align-content: start; }
  .grad h3 { margin-top: var(--space-2); }
  .studio-list { margin-top: var(--space-8); display: grid; gap: var(--space-4); }
  .studio-list ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .studio-list li { padding: var(--space-2) var(--space-3); border: var(--border-width) solid var(--border-subtle); font-size: var(--type-small); }
</style>
<script>
  const form = document.getElementById('grad-filters') as HTMLFormElement | null;
  if (form) {
    const items = Array.from(document.querySelectorAll<HTMLElement>('.grad'));
    const empty = document.getElementById('grad-empty')!;
    const apply = () => {
      const fd = new FormData(form); const c = String(fd.get('course') || ''); const a = String(fd.get('area') || '');
      let n = 0; items.forEach((i) => { const ok = (!c || i.dataset.course === c) && (!a || i.dataset.area === a); i.hidden = !ok; if (ok) n++; });
      empty.hidden = n > 0;
    };
    form.addEventListener('change', apply);
  }
</script>
