---
/**
 * "Where our students are teaching". Dot-matrix land layer (static SVG, built by scripts/build-world-map.mjs)
 * with markers, labels and great-circle arcs from the training centre drawn inline in the same viewBox.
 * Labels show from 768px; the list below is the text alternative and the mobile readout.
 */
import { projection, point, arcPath, VIEW_WIDTH } from '@/lib/worldmap.mjs';
import type { SiteSettings } from '@/lib/types';
interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const map = settings.teachingMap;
const { height } = projection();
const home = map ? point(map.home.lng, map.home.lat) : null;
const places = (map?.locations ?? []).map((l, i) => {
  const p = point(l.lng, l.lat);
  const dx = l.labelDx ?? 12, dy = l.labelDy ?? 4;
  const anchor = l.anchor ?? 'start';
  const lx = p.x + dx, ly = p.y + dy;
  // Leader stops at the edge of the label rather than running through the text.
  const end = anchor === 'end' ? [lx + 3, ly - 4] : anchor === 'start' ? [lx - 3, ly - 4] : dy > 0 ? [lx, ly - 11] : [lx, ly + 3];
  return { ...l, ...p, i, lx, ly, anchor, leader: Math.hypot(dx, dy) > 18, end, arc: arcPath([map!.home.lng, map!.home.lat], [l.lng, l.lat]) };
});
// Small-screen crop: the box around all pins plus padding, so markers stay readable on phones.
const xs = [home?.x ?? 0, ...places.map((p) => p.x)], ys = [home?.y ?? 0, ...places.map((p) => p.y)];
const pad = 36;
const cx0 = Math.max(0, Math.min(...xs) - pad), cx1 = Math.min(VIEW_WIDTH, Math.max(...xs) + pad);
const cy0 = Math.max(0, Math.min(...ys) - pad), cy1 = Math.min(height, Math.max(...ys) + pad);
const crop = { w: cx1 - cx0, h: cy1 - cy0 };
const cropVars = `--crop-ratio: ${crop.w.toFixed(1)} / ${crop.h.toFixed(1)}; --crop-scale: ${(VIEW_WIDTH / crop.w * 100).toFixed(2)}%; --crop-left: ${(-cx0 / crop.w * 100).toFixed(2)}%; --crop-top: ${(-cy0 / crop.h * 100).toFixed(2)}%; --full-ratio: ${VIEW_WIDTH} / ${height};`;
const regions = Array.from(new Set(places.map((p) => p.region ?? p.name)));
const label = map ? `${map.heading}: ${places.map((p) => p.name).join(', ')}. All trained at ${map.home.name}.` : '';
---
{map && places.length > 0 && home && (
  <section class="section world" aria-labelledby="world-heading">
    <div class="container reveal">
      <header class="world-heading">
        {map.eyebrow && <p class="eyebrow">{map.eyebrow}</p>}
        <h2 id="world-heading">{map.heading}</h2>
        {map.lead && <p class="lead">{map.lead}</p>}
      </header>
      <figure class="world-figure">
        <div class="world-frame" style={cropVars}>
        <div class="world-map">
          <img src="/images/world-dots.svg" alt="" width={VIEW_WIDTH} height={height} loading="lazy" decoding="async" />
          <svg viewBox={`0 0 ${VIEW_WIDTH} ${height}`} role="img" aria-label={label}>
            <g class="arcs" aria-hidden="true">
              {places.map((p) => <path class="arc" d={p.arc} pathLength="1" style={`--i:${p.i}`} />)}
            </g>
            <g class="home" aria-hidden="true">
              <circle class="home-ring" cx={home.x} cy={home.y} r="9" />
              <circle class="home-dot" cx={home.x} cy={home.y} r="4.5" />
            </g>
            {places.map((p) => (
              <g class="place" style={`--i:${p.i}`}>
                <title>{p.region && p.region !== p.name ? `${p.name}, ${p.region}` : p.name}</title>
                {p.leader && <line class="leader" x1={p.x} y1={p.y} x2={p.end[0]} y2={p.end[1]} aria-hidden="true" />}
                <circle class="pulse" cx={p.x} cy={p.y} r="4.5" aria-hidden="true" />
                <circle class="dot" cx={p.x} cy={p.y} r="4.5" />
                <text class="label" x={p.lx} y={p.ly} text-anchor={p.anchor} aria-hidden="true">{p.name}</text>
              </g>
            ))}
            <text class="label home-label" x={home.x + 10} y={home.y - 10} text-anchor="start" aria-hidden="true">{map.home.name}</text>
          </svg>
        </div>
        </div>
        <figcaption class="world-list">
          <p class="small muted legend"><span><span class="key key-home" aria-hidden="true"></span>Trained at our {map.home.name} centre</span><span><span class="key key-place" aria-hidden="true"></span>Now teaching</span></p>
          <ul role="list">
            {regions.map((r) => {
              const names = places.filter((p) => (p.region ?? p.name) === r).map((p) => p.name);
              return <li><strong>{names.join(', ')}</strong>{names.length === 1 && names[0] === r ? null : <span class="muted">{r}</span>}</li>;
            })}
          </ul>
        </figcaption>
      </figure>
    </div>
  </section>
)}
<style>
  .world-heading { display: grid; gap: var(--space-3); margin-bottom: var(--space-6); }
  .world-figure { margin: 0; display: grid; gap: var(--space-5); }
  .world-frame { position: relative; width: 100%; aspect-ratio: var(--full-ratio); }
  .world-map { position: absolute; inset: 0; }
  /* Phones: zoom to the pins. The inner map keeps its own ratio and is offset inside a clipped frame. */
  @media (max-width: 767px) {
    .world-frame { aspect-ratio: var(--crop-ratio); overflow: hidden; }
    .world-map { inset: auto; left: var(--crop-left); top: var(--crop-top); width: var(--crop-scale); aspect-ratio: var(--full-ratio); }
    .dot, .pulse { r: 6; }
    .home-dot { r: 6; }
    .home-ring { r: 11; }
    .arc { stroke-width: 1.8; }
  }
  .world-map img, .world-map svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .world-map svg { overflow: visible; }
  .arc { fill: none; stroke: var(--bronze-300); stroke-width: 1.4; stroke-dasharray: 1; stroke-dashoffset: 1; stroke-linecap: round; transition: stroke-dashoffset var(--dur-slow) var(--ease-out); transition-delay: calc(var(--stagger) * 3 * var(--i)); }
  .home-ring { fill: none; stroke: var(--ink-900); stroke-width: 1.2; }
  .home-dot { fill: var(--ink-900); }
  .dot { fill: var(--bronze-700); stroke: var(--bg-page); stroke-width: 2; opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(0.4); transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); transition-delay: calc(var(--stagger) * 3 * var(--i) + var(--dur-base)); }
  .pulse { fill: var(--bronze-700); opacity: 0; transform-box: fill-box; transform-origin: center; pointer-events: none; }
  .leader { stroke: var(--text-muted); stroke-width: 0.8; }
  .label { font-family: var(--font-body); font-size: 11.5px; font-weight: var(--weight-regular); fill: var(--text-secondary); opacity: 0; transition: opacity var(--dur-base) var(--ease-out); transition-delay: calc(var(--stagger) * 3 * var(--i) + var(--dur-slow)); }
  .home-label { font-weight: var(--weight-medium); fill: var(--text-primary); }
  .leader { opacity: 0; transition: opacity var(--dur-base) var(--ease-out); transition-delay: calc(var(--stagger) * 3 * var(--i) + var(--dur-slow)); }
  .reveal.is-visible .arc, .no-js .arc { stroke-dashoffset: 0; }
  .reveal.is-visible .dot, .no-js .dot { opacity: 1; transform: none; }
  .reveal.is-visible .label, .reveal.is-visible .leader, .no-js .label, .no-js .leader { opacity: 1; }
  .reveal.is-visible .pulse { animation: pulse calc(var(--dur-slow) * 6) var(--ease-out) infinite; animation-delay: calc(var(--stagger) * 6 * var(--i) + var(--dur-slow) * 2); }
  @keyframes pulse { 0% { opacity: 0.35; transform: scale(1); } 70%, 100% { opacity: 0; transform: scale(3.2); } }
  .place:hover .dot { transform: scale(1.3); }
  .place:hover .label { fill: var(--text-primary); }
  /* Labels are too small to read under 768px; the list carries the names there. */
  @media (max-width: 767px) { .label, .leader { display: none; } }
  .world-list { display: grid; gap: var(--space-3); }
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .legend > span { white-space: nowrap; }
  .world-list ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
  .world-list li { display: inline-flex; gap: var(--space-2); align-items: baseline; font-size: var(--type-small); }
  .world-list strong { font-weight: var(--weight-medium); color: var(--text-primary); }
  .key { display: inline-block; width: var(--space-2); height: var(--space-2); border-radius: var(--radius-pill); margin-right: var(--space-2); vertical-align: middle; }
  .key-home { background: var(--ink-900); }
  .key-place { background: var(--bronze-700); }
  @media (prefers-reduced-motion: reduce) { .pulse { display: none; } }
</style>
