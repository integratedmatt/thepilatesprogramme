---
import type { SiteSettings } from '@/lib/types';
interface Props { settings: SiteSettings; class?: string; tone?: 'light' | 'dark' }
const { settings, class: className = '', tone = 'light' } = Astro.props;
const badges = settings.accreditationBadges?.filter((b) => b.name) ?? [];
---
{badges.length > 0 && (
  <a href="/accreditation" class={`accreditation-strip ${tone} ${className}`.trim()} aria-label="Accredited by ITTAP through the Pilates Method Alliance; CIMSPA Training Partner. Read about our accreditation">
    <span class="eyebrow">Accredited by</span>
    <ul role="list">
      {badges.map((b) => (
        <li>
          {b.image?.url ? <img src={b.image.url} alt={b.image.alt || b.name} height="40" width={b.image.width && b.image.height ? Math.round((b.image.width / b.image.height) * 40) : undefined} loading="lazy" /> : <span class="badge-text">{b.name}</span>}
        </li>
      ))}
    </ul>
  </a>
)}
<style>
  .accreditation-strip { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); text-decoration: none; color: inherit; }
  .accreditation-strip ul { display: flex; flex-wrap: wrap; gap: var(--space-5); list-style: none; align-items: center; }
  .accreditation-strip img { height: var(--badge-height); width: auto; filter: grayscale(1); opacity: 0.85; }
  .accreditation-strip.dark img { filter: grayscale(1) invert(1); opacity: 0.8; }
  .accreditation-strip img { transition: opacity var(--dur-fast) var(--ease-out); }
  .accreditation-strip:hover img { opacity: 1; }
  .badge-text { display: inline-flex; align-items: center; height: var(--badge-height); max-width: 9em; font-size: var(--type-small); font-weight: var(--weight-medium); line-height: var(--leading-h3); color: var(--text-secondary); }
  .accreditation-strip.dark .badge-text { color: var(--stone-300); }
  @media (max-width: 767px) {
    .accreditation-strip { flex-direction: column; align-items: center; text-align: center; }
    .accreditation-strip ul { justify-content: center; }
  }
</style>
