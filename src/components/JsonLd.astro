---
import { clean } from '@/lib/schema';
interface Props { data: unknown | unknown[] | null }
const { data } = Astro.props;
const items = (Array.isArray(data) ? data : [data]).filter(Boolean).map(clean);
---
{items.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
