---
import { getQualifyCourses, getContinueCourses, courseUrl } from '@/lib/content';
import { priceLine, durationLabel } from '@/lib/format';
import type { SiteSettings } from '@/lib/types';
interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const qualify = await getQualifyCourses();
const continueCourses = (await getContinueCourses()).filter((c) => c.kind !== 'bundle');
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const apparatus = continueCourses.filter((c) => c.kind !== 'cpd');
// One "Courses" menu holds both paths side by side, so visitors see every course before choosing a route.
// The header button is Book a call (client, 8 Oct 2026); Course dates lives in the Plan menu. Journal, FAQs and Contact live in the footer.
const links = [
  { label: 'Jobs', href: '/jobs' },
  { label: 'About', href: '/about' },
];
const planLinks = [
  { label: 'Course dates', href: '/course-dates' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Road to Certification', href: '/become-a-pilates-instructor/road-to-certification' },
  { label: 'Accreditation', href: '/accreditation' },
  { label: 'FAQs', href: '/faqs' },
];
const coursesActive = ['/become-a-pilates-instructor', '/continuing-education', '/pricing', '/accreditation'].some(isActive);
const meta = (c: (typeof qualify)[number]) => [durationLabel(c) ?? (c.format === 'online' ? 'Online' : 'In person'), c.price != null ? priceLine(c.price, c.financeOptions) : ''].filter(Boolean).join(' · ');
---
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${settings.siteName} home`}>
      {settings.logo?.url ? <img src={settings.logo.url} alt="" width={settings.logo.width ?? 220} height={settings.logo.height ?? 40} /> : <span class="logo-text">{settings.siteName}</span>}
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        <li class="has-menu">
          <button type="button" class:list={['nav-link', { 'is-active': coursesActive }]} aria-expanded="false" aria-controls="menu-courses" data-menu-trigger="courses">Courses<span class="chev" aria-hidden="true"></span></button>
          <div class="mega motion-pop" id="menu-courses" hidden data-menu="courses">
            <div class="container mega-inner">
              <section class="mega-group" aria-labelledby="mega-qualify">
                <p class="eyebrow">I want to certify</p>
                <a href="/become-a-pilates-instructor" class="mega-heading" id="mega-qualify">Become a teacher</a>
                <ul class="mega-list" role="list">
                  {qualify.map((c) => <li><a href={courseUrl(c)} class="mega-item"><span class="mega-item-title">{c.shortTitle} teacher training</span><span class="small muted">{meta(c)}</span></a></li>)}
                </ul>
                <a href="/become-a-pilates-instructor/which-course" class="arrow-link small">Which course is right for me?</a>
              </section>
              <section class="mega-group" aria-labelledby="mega-continue">
                <p class="eyebrow">I'm already a teacher</p>
                <a href="/continuing-education" class="mega-heading" id="mega-continue">Continue learning</a>
                <ul class="mega-list" role="list">
                  {apparatus.map((c) => <li><a href={courseUrl(c)} class="mega-item"><span class="mega-item-title">{c.shortTitle}</span><span class="small muted">{meta(c)}</span></a></li>)}
                  <li><a href="/continuing-education/cpd" class="mega-item"><span class="mega-item-title">CPD courses</span><span class="small muted">One-day courses, in person or online</span></a></li>
                </ul>
              </section>
              <section class="mega-plan" aria-labelledby="mega-plan">
                <p class="eyebrow" id="mega-plan">Plan your training</p>
                <ul class="mega-plan-list" role="list">
                  {planLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
                </ul>
              </section>
            </div>
          </div>
        </li>
        {links.map((l) => (
          <li><a href={l.href} class:list={['nav-link', { 'is-active': isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/book-a-call" class="btn btn-primary btn-book" data-placement="header"><span class="book-full">Book a call</span><span class="book-short">Call</span></a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav motion-pop" id="mobile-nav" hidden>
    <div class="container mobile-inner">
      <div class="mobile-tiles" data-stagger>
        <a href="/become-a-pilates-instructor" class="mobile-tile">
          <span class="eyebrow">I want to certify</span>
          <span class="h3">Become a Pilates or Barre teacher</span>
        </a>
        <a href="/continuing-education" class="mobile-tile">
          <span class="eyebrow">I'm already a teacher</span>
          <span class="h3">Continue learning</span>
        </a>
      </div>
      <ul class="mobile-links rule-list" data-stagger>
        <li><a href="/become-a-pilates-instructor/which-course">Which course is right for me?</a></li>
        <li><a href="/book-a-call">Book a call</a></li>
        <li><a href="/course-dates">Course dates</a></li>
        <li><a href="/pricing">Pricing</a></li>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 80; background: color-mix(in srgb, var(--bg-page) 95%, transparent); backdrop-filter: blur(var(--space-2)); -webkit-backdrop-filter: blur(var(--space-2)); border-bottom: var(--border-width) solid transparent; transition: border-color var(--dur-base) var(--ease-out); }
  .site-header.is-scrolled { border-bottom-color: var(--border-subtle); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); height: var(--header-height-mobile); }
  @media (min-width: 1024px) { .header-inner { height: var(--header-height); } }
  .logo { display: inline-flex; align-items: center; text-decoration: none; color: var(--text-primary); min-height: var(--touch-target); }
  .logo img { height: var(--space-6); width: auto; }
  .logo-text { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--type-lead); letter-spacing: var(--tracking-h2); }
  .nav-desktop { display: none; }
  @media (min-width: 1024px) { .nav-desktop { display: block; } }
  .nav-desktop > ul { display: flex; gap: var(--space-4); list-style: none; }
  .nav-link { display: inline-flex; align-items: center; white-space: nowrap; min-height: var(--touch-target); padding: var(--space-2) var(--space-2); background: none; border: 0; cursor: pointer; text-decoration: none; color: var(--text-secondary); font-size: var(--type-small); font-weight: var(--weight-medium); letter-spacing: var(--tracking-button); border-bottom: var(--focus-width) solid transparent; transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
  .nav-link:hover, .nav-link[aria-expanded="true"], .nav-link.is-active { color: var(--text-primary); border-bottom-color: var(--bronze-700); }
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--bg-surface); border-bottom: var(--border-width) solid var(--border-subtle); padding-block: var(--space-7); }
  .mega-inner { display: grid; grid-template-columns: 4fr 4fr 3fr; gap: var(--space-8); }
  .mega-group, .mega-plan { display: grid; gap: var(--space-3); align-content: start; }
  .mega-heading { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--type-h3); color: var(--text-primary); text-decoration: none; }
  .mega-heading:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .mega-list { list-style: none; display: grid; border-top: var(--border-width) solid var(--border-subtle); margin-block: var(--space-2); }
  .mega-list li { border-bottom: var(--border-width) solid var(--border-subtle); }
  .mega-item { display: grid; gap: var(--space-1); padding: var(--space-3) var(--space-2); text-decoration: none; color: var(--text-primary); transition: background-color var(--dur-fast) var(--ease-out); }
  .mega-item:hover, .mega-item:focus-visible { background: var(--bg-subtle); }
  .mega-item-title { font-weight: var(--weight-medium); }
  .mega-plan { padding-left: var(--space-7); border-left: var(--border-width) solid var(--border-subtle); }
  .mega-plan-list { list-style: none; display: grid; gap: var(--space-3); }
  .mega-plan-list a { color: var(--text-primary); text-decoration: none; }
  .mega-plan-list a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .chev { display: inline-block; width: 0.45em; height: 0.45em; margin-left: var(--space-2); border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-0.15em) rotate(45deg); transition: transform var(--dur-fast) var(--ease-out); }
  .nav-link[aria-expanded="true"] .chev { transform: translateY(0.05em) rotate(-135deg); }
  .mobile-nav:not([hidden]) [data-stagger] > * { animation: rise var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--stagger) * var(--i, 0)); }
  .header-actions { display: flex; align-items: center; gap: var(--space-3); }
  .btn-book { min-height: var(--touch-target); padding: var(--space-3) var(--space-4); white-space: nowrap; }
  .book-full { display: none; }
  @media (min-width: 768px) { .book-full { display: inline; } .book-short { display: none; } }
  @media (min-width: 1440px) { .nav-link { padding-inline: var(--space-3); } .nav-desktop > ul { gap: var(--space-5); } }
  .menu-toggle { display: inline-grid; gap: var(--space-1); place-content: center; width: var(--touch-target); height: var(--touch-target); background: none; border: 0; cursor: pointer; }
  .menu-toggle .bar { display: block; width: var(--space-5); height: var(--focus-width); background: var(--ink-900); transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out); }
  .menu-toggle[aria-expanded="true"] .bar:nth-child(1) { transform: translateY(calc(var(--space-1) + var(--focus-width))) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .bar:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] .bar:nth-child(3) { transform: translateY(calc(-1 * (var(--space-1) + var(--focus-width)))) rotate(-45deg); }
  @media (min-width: 1024px) { .menu-toggle { display: none; } }
  .mobile-nav { position: fixed; left: 0; right: 0; top: var(--header-height-mobile); height: calc(100dvh - var(--header-height-mobile)); background: var(--bg-page); overflow-y: auto; z-index: 79; }
  .mobile-inner { padding-block: var(--space-5) var(--space-8); display: grid; gap: var(--space-6); }
  .mobile-tiles { display: grid; gap: var(--space-3); }
  .mobile-tile { display: grid; gap: var(--space-2); padding: var(--space-5); background: var(--bg-inverse); color: var(--text-inverse); text-decoration: none; }
  .mobile-tile .eyebrow { color: var(--text-inverse-accent); }
  .mobile-links { list-style: none; }
  .mobile-links a { display: block; padding: var(--space-4) 0; text-decoration: none; color: var(--text-primary); font-size: var(--type-lead); font-family: var(--font-display); font-weight: var(--weight-display); }
  body.nav-open { overflow: hidden; }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const threshold = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--scroll-threshold')) || 24;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > threshold);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mega-menus: button with aria-expanded, Esc closes, focus returns to trigger, arrow keys move between items.
  const triggers = Array.from(header.querySelectorAll<HTMLButtonElement>('[data-menu-trigger]'));
  function closeAll(except?: HTMLButtonElement) {
    triggers.forEach((t) => {
      if (t === except) return;
      t.setAttribute('aria-expanded', 'false');
      const panel = header.querySelector<HTMLElement>(`[data-menu="${t.dataset.menuTrigger}"]`);
      if (panel) panel.hidden = true;
    });
  }
  triggers.forEach((t) => {
    const panel = header.querySelector<HTMLElement>(`[data-menu="${t.dataset.menuTrigger}"]`)!;
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') === 'true';
      closeAll(t);
      t.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
      if (!open) panel.querySelector<HTMLElement>('a')?.focus();
    });
    panel.addEventListener('keydown', (e) => {
      const items = Array.from(panel.querySelectorAll<HTMLElement>('a'));
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); items[(i + 1) % items.length]?.focus(); }
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); items[(i - 1 + items.length) % items.length]?.focus(); }
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = triggers.find((t) => t.getAttribute('aria-expanded') === 'true');
    if (open) { closeAll(); open.focus(); }
    if (toggle.getAttribute('aria-expanded') === 'true') { toggleMobile(false); toggle.focus(); }
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.has-menu')) closeAll();
  });

  // Mobile nav
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const mobile = document.getElementById('mobile-nav')!;
  function toggleMobile(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobile.hidden = !open;
    document.body.classList.toggle('nav-open', open);
  }
  toggle.addEventListener('click', () => toggleMobile(toggle.getAttribute('aria-expanded') !== 'true'));
</script>
