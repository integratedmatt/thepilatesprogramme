---
/**
 * Breadcrumbs are schema only. Client direction (12 Oct 2026): no visible breadcrumb trail anywhere,
 * so this renders the BreadcrumbList JSON-LD for search engines and nothing on the page.
 */
import JsonLd from './JsonLd.astro';
import { breadcrumbSchema } from '@/lib/schema';
interface Props { items: { name: string; url: string }[]; class?: string }
const { items } = Astro.props;
const siteUrl = Astro.site?.origin ?? 'https://www.thepilatesprogramme.co.uk';
const all = [{ name: 'Home', url: '/' }, ...items];
---
<JsonLd data={breadcrumbSchema(all, siteUrl)} />
