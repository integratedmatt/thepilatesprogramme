---
/**
 * Home page quote wall. CMS testimonials plus relevant Google reviews (fetched at build from the official Places API).
 * Google reviews show the author's name, rating and a Google attribution, as Google's display policy requires.
 * Hides entirely when there is nothing real to show.
 */
import Stars from './Stars.astro';
import { getGoogleReviews } from '@/lib/content';
import type { SiteSettings, Testimonial } from '@/lib/types';
interface Props { items: Testimonial[]; settings: SiteSettings; heading?: string }
const { items, settings, heading = 'What students say about training here' } = Astro.props;
const google = getGoogleReviews();
const hasRating = typeof google.rating === 'number' && typeof google.count === 'number' && google.count > 0;
const googleCards = google.relevant;
---
{(items.length > 0 || googleCards.length > 0) && (
  <section class="section section-subtle" aria-labelledby="wall-heading">
    <div class="container reveal">
      <header class="wall-heading">
        <p class="eyebrow">In their words</p>
        <h2 id="wall-heading">{heading}</h2>
        {settings.heroTrustLine && <p class="lead">{settings.heroTrustLine}, in their own words.</p>}
        {hasRating && (
          <a class="google-badge" href={google.url || settings.googleReviewUrl || undefined} target="_blank" rel="noopener">
            <Stars rating={google.rating!} size="md" />
            <span><strong>{google.rating!.toFixed(1)}</strong> on Google from {google.count} reviews</span>
          </a>
        )}
      </header>
      <ul class="wall" role="list" data-stagger tabindex="0" aria-label="Student testimonials, scroll sideways for more">
        {items.map((t) => (
          <li class="wall-item">
            <blockquote>
              <span class="mark" aria-hidden="true">“</span>
              <p class="wall-quote">{t.quote}</p>
              <footer>
                <cite>{t.name}</cite>
                {(t.course || t.teachesAt) && <span class="small muted">{[t.course, t.teachesAt ? `Now teaching at ${t.teachesAt}` : ''].filter(Boolean).join(' · ')}</span>}
              </footer>
            </blockquote>
          </li>
        ))}
        {googleCards.map((r) => (
          <li class="wall-item">
            <blockquote>
              <span class="review-head"><Stars rating={r.rating ?? 5} /><span class="tag">Google review</span></span>
              <p class="wall-quote">{r.text.length > 360 ? `${r.text.slice(0, 357).replace(/\s+\S*$/, '')}…` : r.text}</p>
              <footer>
                <cite>{r.authorUrl ? <a href={r.authorUrl} target="_blank" rel="noopener nofollow">{r.author}</a> : r.author}</cite>
                <span class="small muted">{[r.relativeTime, 'Reviewed on Google'].filter(Boolean).join(' · ')}</span>
              </footer>
            </blockquote>
          </li>
        ))}
      </ul>
      <p class="wall-more">
        <span class="wall-links"><a href="/graduates" class="arrow-link">Meet our graduates</a>{hasRating && google.url && <a href={google.url} class="arrow-link" target="_blank" rel="noopener">Read all reviews on Google</a>}</span>
        <span class="wall-controls" data-wall-controls hidden>
          <button type="button" class="wall-btn" data-wall-prev aria-label="Previous testimonials">‹</button>
          <span class="wall-dots" aria-hidden="true"></span>
          <button type="button" class="wall-btn" data-wall-next aria-label="Next testimonials">›</button>
        </span>
        <span class="small muted wall-hint" data-wall-hint>Scroll for more</span>
      </p>
    </div>
  </section>
)}
<style>
  .wall-heading { display: grid; gap: var(--space-2); margin-bottom: var(--space-6); }
  .wall-heading h2 { font-size: var(--type-h3); }
  .wall-heading .lead { font-size: var(--type-body); }
  /* Mobile: one row, horizontal scroll with snap, bleeding to the viewport edge. */
  .wall { list-style: none; display: flex; gap: var(--space-3); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--margin-outer); margin-inline: calc(-1 * var(--margin-outer)); padding-inline: var(--margin-outer); padding-bottom: var(--space-2); -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .wall::-webkit-scrollbar { display: none; }
  .wall-item { flex: 0 0 82%; scroll-snap-align: start; }
  /* Wider screens: still one row, more cards visible, scroll for the rest. */
  @media (min-width: 768px) { .wall { gap: var(--space-4); } .wall-item { flex-basis: calc((100% - var(--space-4)) / 2 - var(--space-2)); } }
  @media (min-width: 1024px) { .wall-item { flex-basis: calc((100% - 2 * var(--space-4)) / 3 - var(--space-2)); } }
  .wall:focus-within, .wall:hover { scrollbar-width: thin; }
  .wall-item blockquote { margin: 0; display: grid; align-content: start; gap: var(--space-3); padding: var(--space-5); background: var(--bg-surface); border: var(--border-width) solid var(--border-subtle); height: 100%; transition: border-color var(--dur-fast) var(--ease-out); }
  .wall-item:hover blockquote { border-color: var(--border-strong); }
  .mark { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--type-h2); line-height: var(--leading-button); color: var(--text-link); height: var(--space-4); }
  .wall-quote { font-size: var(--type-body); line-height: var(--leading-lead); font-weight: var(--weight-regular); color: var(--text-primary); max-width: none; }
  .wall-item footer { display: grid; gap: var(--space-1); padding-top: var(--space-3); margin-top: auto; border-top: var(--border-width) solid var(--border-subtle); }
  cite { font-style: normal; font-size: var(--type-small); font-weight: var(--weight-medium); letter-spacing: var(--tracking-button); color: var(--text-secondary); }
  .google-badge { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-2); text-decoration: none; color: var(--text-secondary); font-size: var(--type-small); }
  .google-badge strong { color: var(--text-primary); font-weight: var(--weight-medium); }
  .google-badge:hover span { color: var(--text-primary); }
  .review-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-height: var(--space-4); }
  .tag { font-size: var(--type-eyebrow); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--text-muted); font-weight: var(--weight-medium); }
  cite a { color: inherit; text-decoration: none; }
  cite a:hover { color: var(--text-link); text-decoration: underline; }
  .wall-links { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  .wall-more { margin-top: var(--space-5); display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); max-width: none; flex-wrap: wrap; }
  /* Carousel controls (pattern from Relume Testimonial 41): prev/next scroll the snap list one card at a time; dots show position. */
  .wall-controls { display: inline-flex; align-items: center; gap: var(--space-3); }
  .wall-controls[hidden] { display: none; }
  .wall-btn { display: inline-flex; align-items: center; justify-content: center; width: var(--button-min-height); height: var(--button-min-height); border: var(--border-width) solid var(--border-strong); border-radius: var(--radius-pill); background: var(--bg-surface); color: var(--text-primary); font-size: var(--type-h3); line-height: 1; cursor: pointer; transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .wall-btn:hover { background: var(--button-primary-bg); color: var(--button-primary-text); }
  .wall-btn:active { transform: translateY(var(--press)); }
  .wall-btn:focus-visible { outline: var(--focus-width) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .wall-dots { display: inline-flex; gap: var(--space-2); }
  .wall-dots i { display: block; width: var(--space-2); height: var(--space-2); border-radius: var(--radius-pill); background: var(--border-subtle); transition: background var(--dur-fast) var(--ease-out); }
  .wall-dots i.is-on { background: var(--ink-900); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.wall').forEach((wall) => {
    const root = wall.parentElement!;
    const controls = root.querySelector<HTMLElement>('[data-wall-controls]');
    const hint = root.querySelector<HTMLElement>('[data-wall-hint]');
    const items = Array.from(wall.children) as HTMLElement[];
    if (!controls || items.length < 2) return;
    const overflow = () => wall.scrollWidth > wall.clientWidth + 8;
    if (!overflow()) return;
    controls.hidden = false; if (hint) hint.hidden = true;
    const dots = controls.querySelector('.wall-dots')!;
    items.forEach(() => dots.appendChild(document.createElement('i')));
    const step = () => items[1].offsetLeft - items[0].offsetLeft;
    const index = () => Math.round(wall.scrollLeft / step());
    const paint = () => { const i = index(); dots.querySelectorAll('i').forEach((d, j) => d.classList.toggle('is-on', j === i)); };
    const go = (dir: number) => wall.scrollBy({ left: dir * step(), behavior: 'smooth' });
    controls.querySelector('[data-wall-prev]')!.addEventListener('click', () => go(-1));
    controls.querySelector('[data-wall-next]')!.addEventListener('click', () => go(1));
    let raf = 0; wall.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  });
</script>
