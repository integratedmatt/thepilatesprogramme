---
/** Home page quote wall. CMS testimonials only; hides entirely when empty. */
import type { SiteSettings, Testimonial } from '@/lib/types';
interface Props { items: Testimonial[]; settings: SiteSettings; heading?: string }
const { items, settings, heading = 'What students say about training here' } = Astro.props;
---
{items.length > 0 && (
  <section class="section section-subtle" aria-labelledby="wall-heading">
    <div class="container reveal">
      <header class="wall-heading">
        <p class="eyebrow">In their words</p>
        <h2 id="wall-heading">{heading}</h2>
        {settings.heroTrustLine && <p class="lead">{settings.heroTrustLine}. Every quote is from a student, in their own words.</p>}
      </header>
      <ul class="wall" role="list" data-stagger>
        {items.map((t) => (
          <li class="wall-item">
            <blockquote>
              <span class="mark" aria-hidden="true">“</span>
              <p class="wall-quote">{t.quote}</p>
              <footer>
                <cite>{t.name}</cite>
                {(t.course || t.teachesAt) && <span class="small muted">{[t.course, t.teachesAt ? `Now teaching at ${t.teachesAt}` : ''].filter(Boolean).join(' · ')}</span>}
              </footer>
            </blockquote>
          </li>
        ))}
      </ul>
      <p class="wall-more"><a href="/graduates" class="arrow-link">Meet our graduates</a></p>
    </div>
  </section>
)}
<style>
  .wall-heading { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); }
  .wall { list-style: none; columns: 1; column-gap: var(--space-5); }
  @media (min-width: 768px) { .wall { columns: 2; } }
  @media (min-width: 1024px) { .wall { columns: 3; } }
  .wall-item { break-inside: avoid; margin-bottom: var(--space-5); }
  .wall-item blockquote { margin: 0; display: grid; gap: var(--space-4); padding: var(--space-6); background: var(--bg-surface); border: var(--border-width) solid var(--border-subtle); transition: border-color var(--dur-fast) var(--ease-out); }
  .wall-item:hover blockquote { border-color: var(--border-strong); }
  .mark { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--type-h1); line-height: var(--leading-button); color: var(--text-link); }
  .wall-quote { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--type-h3); line-height: var(--leading-h3); color: var(--text-primary); max-width: none; }
  .wall-item footer { display: grid; gap: var(--space-1); padding-top: var(--space-4); border-top: var(--border-width) solid var(--border-subtle); }
  cite { font-style: normal; font-size: var(--type-small); font-weight: var(--weight-medium); letter-spacing: var(--tracking-button); }
  .wall-more { margin-top: var(--space-5); }
</style>
