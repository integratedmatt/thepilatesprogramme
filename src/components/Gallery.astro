---
/**
 * Photo grid with a lightbox (pattern from Relume Gallery 10, ported to a native <dialog>).
 * The grid is plain, indexable <img> markup; the lightbox is progressive enhancement, keyboard
 * operable (Esc closes, arrow keys move) and never loads a second copy of an image until opened.
 */
import Picture from './Picture.astro';
import type { ImageRef } from '@/lib/types';
interface Props { images: ImageRef[]; id?: string; label?: string; columns?: 2 | 3 }
const { images, id = 'gallery', label = 'Photo gallery', columns = 3 } = Astro.props;
---
<div class="gallery-wrap" data-gallery id={id}>
  <ul class:list={['gallery', `cols-${columns}`]} role="list" data-stagger aria-label={label}>
    {images.map((img, i) => (
      <li>
        <button type="button" class="gallery-item img-lift" data-index={i} aria-label={`Open photo ${i + 1} of ${images.length}: ${img.alt}`}>
          <Picture image={img} aspect="landscape" sizes={`(min-width: 1024px) ${Math.round(100 / columns)}vw, (min-width: 768px) 50vw, 100vw`} />
        </button>
      </li>
    ))}
  </ul>
  <dialog class="lightbox" aria-label={label}>
    <form method="dialog" class="lightbox-bar">
      <p class="small lightbox-count" aria-live="polite"></p>
      <button type="submit" class="lightbox-btn" aria-label="Close">×</button>
    </form>
    <figure class="lightbox-figure">
      <img alt="" decoding="async" />
      <figcaption class="small lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="lightbox-btn lightbox-prev" data-prev aria-label="Previous photo">‹</button>
    <button type="button" class="lightbox-btn lightbox-next" data-next aria-label="Next photo">›</button>
  </dialog>
</div>
<style>
  .gallery { list-style: none; display: grid; gap: var(--space-4); }
  @media (min-width: 768px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); } }
  @media (min-width: 1024px) { .gallery.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .gallery-item { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; text-align: left; }
  .gallery-item:focus-visible { outline: var(--focus-width) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .lightbox { border: 0; padding: 0; width: min(100vw, 1400px); max-width: 100vw; height: 100dvh; max-height: 100dvh; background: var(--bg-inverse); color: var(--text-inverse); display: none; grid-template-rows: auto 1fr; }
  .lightbox[open] { display: grid; }
  .lightbox::backdrop { background: color-mix(in srgb, var(--ink-900) 92%, transparent); }
  .lightbox-bar { display: flex; justify-content: space-between; align-items: center; padding: var(--space-4) var(--space-5); }
  .lightbox-count { color: var(--stone-300); margin: 0; }
  .lightbox-figure { margin: 0; display: grid; grid-template-rows: 1fr auto; gap: var(--space-3); padding: 0 var(--space-5) var(--space-5); min-height: 0; }
  .lightbox-figure img { width: 100%; height: 100%; object-fit: contain; min-height: 0; }
  .lightbox-caption { color: var(--stone-300); text-align: center; }
  .lightbox-btn { display: inline-flex; align-items: center; justify-content: center; width: var(--button-min-height); height: var(--button-min-height); border: var(--border-width) solid var(--ink-700); border-radius: var(--radius-pill); background: color-mix(in srgb, var(--ink-900) 70%, transparent); color: var(--text-inverse); font-size: var(--type-h3); line-height: 1; cursor: pointer; transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out); }
  .lightbox-btn:hover { border-color: var(--stone-300); }
  .lightbox-btn:focus-visible { outline: var(--focus-width) solid var(--text-inverse-accent); outline-offset: var(--focus-offset); }
  .lightbox-prev, .lightbox-next { position: absolute; top: 50%; translate: 0 -50%; }
  .lightbox-prev { left: var(--space-4); } .lightbox-next { right: var(--space-4); }
  :global(.no-js) .gallery-item { cursor: default; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('dialog');
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('.gallery-item'));
    if (!dialog || !items.length || typeof dialog.showModal !== 'function') return;
    const img = dialog.querySelector<HTMLImageElement>('img')!;
    const cap = dialog.querySelector<HTMLElement>('.lightbox-caption')!;
    const count = dialog.querySelector<HTMLElement>('.lightbox-count')!;
    const srcOf = (b: HTMLButtonElement) => { const i = b.querySelector('img'); const s = b.querySelector<HTMLSourceElement>('source[type="image/webp"]'); const big = s?.srcset.split(',').map((x) => x.trim().split(' ')[0]).pop(); return { src: big || i?.currentSrc || i?.src || '', alt: i?.alt || '' }; };
    let current = 0;
    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const { src, alt } = srcOf(items[current]);
      img.src = src; img.alt = alt; cap.textContent = alt; count.textContent = `${current + 1} of ${items.length}`;
    };
    items.forEach((b, i) => b.addEventListener('click', () => { show(i); dialog.showModal(); }));
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(current - 1); if (e.key === 'ArrowRight') show(current + 1); });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { items[current]?.focus(); img.removeAttribute('src'); });
  });
</script>
