---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'accent';
  type?: 'button' | 'submit';
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  disabledReason?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', type = 'button', class: className = '', target, rel, disabled, disabledReason, ...rest } = Astro.props;
const cls = `btn btn-${variant} ${className}`.trim();
---
{href && !disabled ? (
  <a href={href} class={cls} target={target} rel={target === '_blank' ? (rel ?? 'noopener') : rel} {...rest}><slot /></a>
) : (
  <span class="btn-wrap">
    <button type={type} class={cls} disabled={disabled} aria-disabled={disabled ? 'true' : undefined} {...rest}><slot /></button>
    {disabled && disabledReason && <span class="small muted">{disabledReason}</span>}
  </span>
)}
<style>
  .btn-wrap { display: inline-grid; gap: var(--space-2); }
</style>
