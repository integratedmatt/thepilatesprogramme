---
/**
 * Image wrapper. Sanity CDN images get AVIF/WebP srcset via URL params; local placeholders render as-is.
 * Always sets width/height to avoid CLS. Hero images pass priority to set fetchpriority="high".
 */
import type { ImageRef } from '@/lib/types';
interface Props {
  image?: ImageRef;
  alt?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  aspect?: 'portrait' | 'landscape' | 'square' | 'none';
  widths?: number[];
}
const { image, alt, sizes = '100vw', priority = false, class: className = '', aspect = 'landscape', widths = [480, 768, 1024, 1440, 1920] } = Astro.props;
const isSanity = image?.url?.includes('cdn.sanity.io');
const ratio = aspect === 'portrait' ? 5 / 4 : aspect === 'square' ? 1 : 2 / 3;
function sanityUrl(w: number, fm: 'avif' | 'webp' | 'jpg') {
  const h = aspect === 'none' ? undefined : Math.round(w * ratio);
  const u = new URL(image!.url);
  u.searchParams.set('w', String(w));
  if (h) { u.searchParams.set('h', String(h)); u.searchParams.set('fit', 'crop'); }
  u.searchParams.set('fm', fm);
  u.searchParams.set('q', '75');
  u.searchParams.set('auto', 'format');
  return u.toString();
}
const width = image?.width ?? 1600;
const height = image?.height ?? (aspect === 'none' ? 1000 : Math.round(width * ratio));
const aspectClass = aspect === 'none' ? '' : `aspect-${aspect}`;
---
{image?.url && (
  <div class={`img-frame ${aspectClass} ${className}`.trim()}>
    {isSanity ? (
      <picture>
        <source type="image/avif" srcset={widths.map((w) => `${sanityUrl(w, 'avif')} ${w}w`).join(', ')} sizes={sizes} />
        <source type="image/webp" srcset={widths.map((w) => `${sanityUrl(w, 'webp')} ${w}w`).join(', ')} sizes={sizes} />
        <img src={sanityUrl(1024, 'jpg')} alt={alt ?? image.alt ?? ''} width={width} height={height} loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'} fetchpriority={priority ? 'high' : undefined} />
      </picture>
    ) : (
      <img src={image.url} alt={alt ?? image.alt ?? ''} width={width} height={height} loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'} fetchpriority={priority ? 'high' : undefined} />
    )}
  </div>
)}
