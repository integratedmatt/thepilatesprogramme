---
import Picture from './Picture.astro';
import type { TeamMember } from '@/lib/types';
interface Props { members: TeamMember[]; heading?: string }
const { members, heading = 'Your trainers' } = Astro.props;
---
{members.length > 0 && (
  <div class="team">
    <header class="team-heading"><p class="eyebrow">Who teaches you</p><h2>{heading}</h2></header>
    <ul class="team-grid" role="list">
      {members.map((m) => (
        <li class="member">
          {m.image && <Picture image={m.image} aspect="portrait" sizes="(min-width: 768px) 33vw, 100vw" />}
          <div class="member-body">
            <h3><a href={`/about/${m.slug}`}>{m.name}</a></h3>
            <p class="small muted">{m.role}</p>
            {m.credentials && m.credentials.length > 0 && <p class="small secondary">{m.credentials.join(' · ')}</p>}
            {m.bio && <p class="secondary">{m.bio}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
)}
<style>
  .team-heading { margin-bottom: var(--space-6); display: grid; gap: var(--space-3); }
  .team-grid { list-style: none; display: grid; gap: var(--space-6); }
  @media (min-width: 768px) { .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .team-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .member { display: grid; gap: var(--space-4); }
  .member-body { display: grid; gap: var(--space-2); }
  .member h3 a { color: var(--text-primary); text-decoration: none; }
  .member h3 a:hover { color: var(--text-link); }
</style>
